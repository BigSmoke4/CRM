@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Enterprise CRM</title>
    <link rel="stylesheet" href="~/css/core/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/core/neumorphic.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/core/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/core/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modules/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    string? orgName = null;
    if (isAuth)
    {
        // org name resolved cheaply via claim fallback; controllers may set ViewBag.OrgName
        orgName = ViewBag.OrgName as string;
    }
}
@if (isAuth)
{
    <header class="topbar neu">
        <button class="icon-btn" id="sidebarToggle" aria-label="Menu" aria-expanded="false">
            <span class="burger"><i></i><i></i><i></i></span>
        </button>
        <h1 class="topbar__title">@ViewData["Title"]</h1>
        <div class="topbar__spacer"></div>
        <div class="topbar__actions">
            <a class="icon-btn" href="/Activities/Create" title="New activity" aria-label="New activity">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
            </a>
            <div class="user-chip neu--sm">
                <span class="user-chip__name">@User.Identity?.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn--sm" title="Sign out">Sign out</button>
                </form>
            </div>
        </div>
    </header>

    <div class="scrim" id="scrim"></div>
    <aside class="sidebar neu" id="sidebar">
        <div class="sidebar__brand">@((orgName ?? "CRM"))<span>.</span></div>
        <nav>
            <ul class="nav-list">
                <li><a class="nav-link" href="/Home"><NavIcon d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>Dashboard</a></li>
                @if (Can("contacts.view") || Can("deals.view") || Can("leads.view"))
                {
                    <li class="nav-group">Sales</li>
                    @if (Can("contacts.view")) { <li><a class="nav-link" href="/Contacts"><NavIcon d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>Contacts</a></li> }
                    @if (Can("accounts.view")) { <li><a class="nav-link" href="/Accounts"><NavIcon d="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/>Accounts</a></li> }
                    @if (Can("leads.view")) { <li><a class="nav-link" href="/Leads"><NavIcon d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>Leads</a></li> }
                    @if (Can("deals.view")) { <li><a class="nav-link" href="/Deals"><NavIcon d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"/>Pipeline</a></li> }
                    @if (Can("deals.forecast")) { <li><a class="nav-link" href="/Deals/Forecast"><NavIcon d="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z"/>Forecast</a></li> }
                }
                @if (Can("activities.view") || Can("tickets.view"))
                {
                    <li class="nav-group">Work</li>
                    @if (Can("activities.view")) { <li><a class="nav-link" href="/Activities"><NavIcon d="M19 3h-4.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>Activities</a></li> }
                    @if (Can("tickets.view")) { <li><a class="nav-link" href="/Tickets"><NavIcon d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/>Tickets</a></li> }
                }
                @if (Can("campaigns.view"))
                {
                    <li class="nav-group">Marketing</li>
                    <li><a class="nav-link" href="/Campaigns"><NavIcon d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>Campaigns</a></li>
                }
                @if (Can("products.view") || Can("orders.view") || Can("invoices.view"))
                {
                    <li class="nav-group">Commerce</li>
                    @if (Can("products.view")) { <li><a class="nav-link" href="/Commerce/Products"><NavIcon d="M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4h16v3z"/>Products</a></li> }
                    @if (Can("orders.view")) { <li><a class="nav-link" href="/Commerce/Orders"><NavIcon d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>Orders</a></li> }
                    @if (Can("invoices.view")) { <li><a class="nav-link" href="/Commerce/Invoices"><NavIcon d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>Invoices</a></li> }
                }
                @if (Can("ai.use") || Can("ai.manage"))
                {
                    <li class="nav-group">AI</li>
                    @if (Can("ai.use")) { <li><a class="nav-link" href="/Ai"><NavIcon d="M12 2a5 5 0 0 1 5 5c0 1.6-.7 3-1.8 4C16.6 11.9 17 13.4 17 15a5 5 0 0 1-10 0c0-1.6.4-3.1 1.8-4A5 5 0 0 1 12 2z"/>AI Assistants</a></li> }
                    @if (Can("ai.manage")) { <li><a class="nav-link" href="/Knowledge"><NavIcon d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-1 9h-4v4h-2v-4H9V9h4V5h2v4h4v2z"/>Knowledge Base</a></li>
                    <li><a class="nav-link" href="/Ai/Providers"><NavIcon d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>AI Providers</a></li> }
                }
                @if (Can("workflows.view"))
                {
                    <li class="nav-group">Automation</li>
                    <li><a class="nav-link" href="/Workflows"><NavIcon d="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"/>Workflows</a></li>
                }
                @if (Can("integrations.view") || Can("reports.view") || Can("settings.view") || Can("users.view"))
                {
                    <li class="nav-group">System</li>
                    @if (Can("integrations.view")) { <li><a class="nav-link" href="/Integrations"><NavIcon d="M20.5 11H19V7c0-1.1-.9-2-2-2h-4V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4c-1.1 0-2 .9-2 2v3.8H3.5c1.49 0 2.7 1.21 2.7 2.7s-1.21 2.7-2.7 2.7H2V20c0 1.1.9 2 2 2h3.8v-1.5c0-1.49 1.21-2.7 2.7-2.7 1.49 0 2.7 1.21 2.7 2.7V22H17c1.1 0 2-.9 2-2v-4h1.5c1.38 0 2.5-1.12 2.5-2.5S21.88 11 20.5 11z"/>Integrations</a></li> }
                    @if (Can("reports.view")) { <li><a class="nav-link" href="/Reports"><NavIcon d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/>Reports</a></li> }
                    @if (Can("users.view")) { <li><a class="nav-link" href="/Users"><NavIcon d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>Users</a></li> }
                    @if (Can("settings.view")) { <li><a class="nav-link" href="/Settings"><NavIcon d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>Settings</a></li> }
                }
                <li><a class="nav-link" href="/Account/Profile"><NavIcon d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>My Profile</a></li>
            </ul>
        </nav>
    </aside>
}

<main class="page">
    @if (TempData["Success"] != null)
    {
        <div class="toast toast--success is-in" data-auto><p>@TempData["Success"]</p></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast toast--error is-in" data-auto><p>@TempData["Error"]</p></div>
    }
    @RenderBody()
</main>

@functions {
    bool Can(string permission) =>
        User.Identity?.IsAuthenticated == true &&
        (User.HasClaim("permission", permission) || User.HasClaim("permission", Crm.Data.Permissions.All) ||
         User.IsInRole("SuperAdmin") || User.FindFirst("is_superadmin")?.Value == "true");
}

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    // Inline SVG icon helper
    static Microsoft.AspNetCore.Html.IHtmlContent NavIcon(string d) =>
        new Microsoft.AspNetCore.Html.HtmlString($"<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"{d}\"/></svg>");
}
