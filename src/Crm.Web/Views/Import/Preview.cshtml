@{
    ViewData["Title"] = "Import preview";
    var batchId = ViewBag.BatchId as string;
    var rowCount = (int)ViewBag.RowCount;
    var unmapped = (List<string>)ViewBag.Unmapped;
    var preview = (List<Dictionary<string, string?>>)ViewBag.Preview;
    var fileName = ViewBag.FileName as string;
}
<section class="panel neu">
    <div class="panel__head">
        <div>
            <h2 class="panel__title">Import preview — @fileName</h2>
            <p class="panel__sub">@rowCount rows detected. Columns were auto-mapped where recognized.</p>
        </div>
    </div>

    @if (unmapped.Any())
    {
        <div class="notice notice--warn">Unmapped columns (will be ignored): @string.Join(", ", unmapped)</div>
    }

    <div class="table-wrap">
        <table class="app-table">
            <thead>
                <tr>@foreach (var h in preview.FirstOrDefault()?.Keys ?? Enumerable.Empty<string>()) { <th>@h</th> }</tr>
            </thead>
            <tbody>
            @foreach (var row in preview)
            {
                <tr>@foreach (var v in row.Values) { <td>@v</td> }</tr>
            }
            </tbody>
        </table>
    </div>
    <p class="panel__sub">Showing first @preview.Count of @rowCount rows.</p>

    <form method="post" action="/Import/ContactsCommit" class="form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="batchId" value="@batchId" />
        <label class="field field--inline"><input type="checkbox" name="skipDuplicates" value="true" checked /> <span>Skip duplicate emails</span></label>
        <div class="btn-row">
            <button class="btn btn--primary" type="submit">Import @rowCount rows</button>
            <a class="btn" href="/Contacts">Cancel</a>
        </div>
    </form>
</section>
