@model Crm.Web.ViewModels.DealFormVm
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit deal" : "New deal";
}
<section class="panel neu">
    <div class="panel__head"><h2 class="panel__title">@ViewData["Title"]</h2></div>
    <form method="post" class="form form--wide">
        @Html.AntiForgeryToken()
        @if (Model.Id.HasValue) { <input type="hidden" asp-for="Id" /> }
        <div asp-validation-summary="ModelOnly" class="form-errors"></div>
        <fieldset class="form-section">
            <legend>Deal</legend>
            <div class="form-grid">
                <label class="field"><span>Name *</span><input asp-for="Name" class="input" required /></label>
                <label class="field"><span>Amount</span><input asp-for="Amount" class="input" type="number" step="0.01" min="0" /></label>
                <label class="field"><span>Currency</span><input asp-for="Currency" class="input" maxlength="3" /></label>
                <label class="field"><span>Probability override (0-100)</span><input asp-for="ProbabilityOverride" class="input" type="number" min="0" max="100" placeholder="stage default" /></label>
                <label class="field"><span>Expected close</span><input asp-for="ExpectedCloseDate" class="input" type="date" /></label>
                <label class="field"><span>Pipeline</span><select asp-for="PipelineId" asp-items="ViewBag.Pipelines" class="input"></select></label>
                <label class="field"><span>Stage</span><select asp-for="StageId" asp-items="ViewBag.Stages" class="input"></select></label>
            </div>
            <label class="field"><span>Description</span><textarea asp-for="Description" class="input" rows="2"></textarea></label>
        </fieldset>
        <fieldset class="form-section">
            <legend>Related records</legend>
            <div class="form-grid">
                <label class="field"><span>Account</span><select asp-for="AccountId" asp-items="ViewBag.Accounts" class="input"><option value="">—</option></select></label>
                <label class="field"><span>Contact</span><select asp-for="ContactId" asp-items="ViewBag.Contacts" class="input"><option value="">—</option></select></label>
                <label class="field"><span>Owner</span><select asp-for="OwnerId" asp-items="ViewBag.Users" class="input"><option value="">— Me —</option></select></label>
                <label class="field"><span>Competitor</span><input asp-for="Competitor" class="input" /></label>
            </div>
        </fieldset>
        <fieldset class="form-section">
            <legend>Notes</legend>
            <label class="field"><span>Tags</span><input asp-for="Tags" class="input" /></label>
            @if (isEdit)
            {
                <label class="field"><span>Lost reason</span><input asp-for="LostReason" class="input" /></label>
            }
            <label class="field"><span>Notes</span><textarea asp-for="Notes" class="input" rows="3"></textarea></label>
        </fieldset>
        <div class="btn-row">
            <button type="submit" class="btn btn--primary">@(isEdit ? "Save changes" : "Create deal")</button>
            <a class="btn" href="/Deals">Cancel</a>
        </div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
